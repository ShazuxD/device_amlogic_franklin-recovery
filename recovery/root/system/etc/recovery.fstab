#<src>               <mnt_point>            <type>  <mnt_flags and options>                                         <fs_mgr_flags>
system               /system                ext4    ro,barrier=1                                                    wait,logical
vendor               /vendor                ext4    ro,barrier=1                                                    wait,logical
product              /product               ext4    ro,barrier=1                                                    wait,logical
odm                  /odm                   ext4    ro,barrier=1                                                    wait,logical

/dev/block/by-name/oem       /oem                   ext4    ro,barrier=1                                                    wait
/dev/block/by-name/metadata  /metadata              ext4    noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic   wait,check,formattable
/dev/block/by-name/data      /data                  ext4    noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic   wait,check,quota,formattable,reservedsize=32M
/dev/block/by-name/odm_ext   /odm_ext               ext4    ro,noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic  wait,check
/dev/block/by-name/cache     /cache                 ext4    noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic   wait,check,formattable
/dev/block/by-name/param     /param                 ext4    noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic   wait,check,quota,formattable
/dev/block/by-name/tee       /tee                   ext4    noatime,nosuid,nodev,nodelalloc,nomblk_io_submit,errors=panic   wait,check,formattable
/dev/block/by-name/factory   /factory               vfat    noatime,nodiratime,nosuid,noexec,dmask=0022                     wait,check
/dev/block/by-name/misc      /misc                  emmc    defaults                                                        defaults
/dev/block/by-name/boot      /boot                  emmc    defaults                                                        defaults
/dev/block/by-name/recovery  /recovery              emmc    defaults                                                        defaults
