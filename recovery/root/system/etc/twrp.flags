# mountpoint   fstype   device   flags

/bootloader   emmc   /dev/block/by-name/bootloader   flags=backup=1
/logo         emmc   /dev/block/by-name/logo         flags=backup=1
/vbmeta       emmc   /dev/block/by-name/vbmeta       flags=backup=1
/recovery     emmc   /dev/block/by-name/recovery     flags=backup=1
/boot         emmc   /dev/block/by-name/boot         flags=backup=1
/misc         emmc   /dev/block/by-name/misc

/system       ext4   /dev/block/mapper/system        flags=display="System";backup=1
/vendor       ext4   /dev/block/mapper/vendor        flags=display="Vendor";backup=1
/odm          ext4   /dev/block/mapper/odm           flags=display="ODM";backup=1
/odm_ext      ext4   /dev/block/by-name/odm_ext      flags=display="ODM Ext";backup=1
/oem          ext4   /dev/block/by-name/oem          flags=display="OEM";backup=1
/product      ext4   /dev/block/mapper/product       flags=display="Product";backup=1
/param        ext4   /dev/block/by-name/param        flags=backup=1
/tee          ext4   /dev/block/by-name/tee          flags=backup=1
/metadata     ext4   /dev/block/by-name/metadata     flags=display="Metadata"
/cache        ext4   /dev/block/by-name/cache        flags=display="cache"

/data         ext4   /dev/block/by-name/data         flags=encryptable=footer;fileencryption=

/usb_otg      auto   /dev/block/by-name/sda1         /dev/block/by-name/sda       flags=display="USB OTG";storage;wipeingui;removable
